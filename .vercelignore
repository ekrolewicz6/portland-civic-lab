# Committed research corpora and published report artifacts (~42 MB).
# Nothing under src/ reads either directory at runtime: the only references
# are provenance comments naming a file. Runtime assets belong in public/.
/reports
/research

# Do NOT add *.pdf here: every PDF outside /reports and /research lives in
# public/ and is served (the deep-dive "full report" links). A blanket
# *.pdf rule shipped 404s for all of them.
*.dump
*.sql.gz
*.log
*.tsbuildinfo

# Private working artifacts never belong in a deployment upload.
/output
/tmp
/AGENTS.md
/.next-campaign-finance
/ingest/orestar/analysis/__pycache__
/.env.local
/.env.*.local
