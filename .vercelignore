/.git
/.next
/node_modules
/data
/etl
/runtime-data
/.claude
/test-results
/coverage

# Exclude working research and report artifacts. The participatory-budgeting
# page shares this one editorial source with its research edition.
/reports
/research/*
!/research/participatory-budgeting-2026
/research/participatory-budgeting-2026/*
!/research/participatory-budgeting-2026/independent-analysis.md

# Do NOT add *.pdf here: every PDF outside /reports and /research lives in
# public/ and is served (the deep-dive "full report" links). A blanket
# *.pdf rule shipped 404s for all of them.
*.dump
*.sql.gz
*.log
*.tsbuildinfo

# Private working artifacts never belong in a deployment upload.
/output
/tmp
/AGENTS.md
/.next-campaign-finance
/ingest/orestar/analysis/__pycache__
/.env.local
/.env.*.local
